# ─────────────────────────────────────────────────────────────
# AI provider (Agnes AI — free, OpenAI-compatible)
# Sign up and create a free key at https://platform.agnes-ai.com/
# Core Swiss Ephemeris features work without a key.
# ─────────────────────────────────────────────────────────────
API_KEY=your_api_key_here
API_URL=https://apihub.agnes-ai.com/v1

# Model Configuration (must match the provider)
ASTRO_MODEL=agnes-2.0-flash
SIMPLIFY_MODEL=agnes-2.0-flash

# Alternative: GapGPT — use Luna for house-by-house simplification
# API_URL=https://api.gapgpt.app/v1
# ASTRO_MODEL=gpt-5.2
# SIMPLIFY_MODEL=gpt-5.6-luna

# Flask Configuration
FLASK_DEBUG=False
SECRET_KEY=your_secret_key_here

# Server Configuration
HOST=0.0.0.0
PORT=5000
